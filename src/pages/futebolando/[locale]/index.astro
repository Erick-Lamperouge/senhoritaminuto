---
import BlogHome from '../../../blog-engine/components/BlogHome.astro';
import {validateBlogConfig} from '../../../blog-engine/lib/config.mjs';
import football from '../../../blog-engine/config/futebolando.json';
export function getStaticPaths(){
  const config=validateBlogConfig(football);
  return config.international.editions.filter(e=>e.path).map(e=>({params:{locale:e.path},props:{locale:e.locale}}));
}
const config=validateBlogConfig(football);
---
<BlogHome config={config} locale={Astro.props.locale} />
