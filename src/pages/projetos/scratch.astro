---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Mascot from '../../components/Mascot.astro';
import ScratchCat from '../../components/ScratchCat.astro';
---
<BaseLayout title="Projeto Scratch — Senhorita Minuto" description="Jogue o projeto Scratch diretamente no portfólio Senhorita Minuto.">
  <Header />
  <main class="project-page project-page-refined project-page-standardized" data-page-title-key="scratch.pageTitle">
    <a class="back-link time-back-link" href="/" data-i18n="common.backTime">← Voltar no Tempo (Início)</a>

    <section class="project-hero-grid">
      <div class="project-hero-main">
        <h1 id="scratchProjectTitle" class="scratch-title-accent" aria-label="Projeto Scratch">Projeto Scratch</h1>
        <p class="project-lead" data-i18n="scratch.lead">Narrativa, interação e uma ameaça felina improvável — tudo reunido em uma experiência jogável criada no Scratch.</p>
        <div class="project-actions emphasis-actions">
          <a class="button primary action-main" href="#jogar" data-i18n="common.goGame">Ir para o jogo</a>
          <a class="button secondary" href="#sobre-projeto" data-i18n="common.aboutProject">Sobre o projeto</a>
        </div>
      </div>

      <aside class="project-showcase-slot" aria-label="Personagem do projeto Scratch">
        <div class="showcase-shell showcase-scratch"><ScratchCat /></div>
      </aside>
    </section>

    <div class="play-here-callout" role="note" aria-label="Dá para jogar diretamente nesta página" data-i18n-aria="common.playHereAria">
      <span class="play-here-signal" aria-hidden="true"></span>
      <span class="play-here-copy">
        <strong data-i18n="common.playHere">Dá para jogar aqui</strong>
        <small data-i18n="common.playHereSub">Jogue sem sair do site</small>
      </span>
      <span class="play-here-arrow" aria-hidden="true">↓</span>
    </div>

    <div class="embed-shell top-embed-shell" id="jogar">
      <iframe src="https://scratch.mit.edu/projects/1280541113/embed" title="Jogo no Scratch" allowfullscreen loading="eager"></iframe>
    </div>

    <div class="project-details" id="sobre-projeto">
      <section>
        <h2 data-i18n="common.aboutProject">Sobre o projeto</h2>
        <p data-i18n="scratch.about1">Aqui você pode conhecer um projeto desenvolvido no Scratch e experimentar sua proposta de forma integrada ao portfólio. A ideia é apresentar não apenas o resultado, mas também a experiência interativa que faz parte dele.</p>
        <p data-i18n="scratch.about2">A história parte de uma premissa bem-humorada: gatos estão se preparando para dominar o mundo. Entre personagens, escolhas e acontecimentos inesperados, o jogador acompanha essa pequena conspiração felina enquanto avança pela experiência.</p>
      </section>
      <section>
        <h2 data-i18n="scratch.origin">Origem</h2>
        <p data-i18n="scratch.originText">O projeto nasceu no Scratch e continua disponível em sua página original, com a mesma experiência que aparece incorporada aqui.</p>
        <a class="external-project-cta" href="https://scratch.mit.edu/projects/1280541113/" target="_blank" rel="noreferrer">
          <span class="external-project-icon" aria-hidden="true">↗</span>
          <span>
            <strong data-i18n="scratch.original">Abrir projeto original no Scratch</strong>
            <small data-i18n="scratch.originalHint">Ver o projeto na plataforma original</small>
          </span>
        </a>
      </section>
    </div>

    <script>
      const renderScratchTitle=()=>{
        const node=document.getElementById('scratchProjectTitle');
        if(!(node instanceof HTMLElement)) return;
        const isEN=window.SM_I18N?.getLanguage?.()==='en';
        const label=isEN?'Scratch Project':'Projeto Scratch';
        const main=isEN?'S<span class="cat-title-accent">cat</span>ch Project':'Projeto S<span class="cat-title-accent">cat</span>ch';
        node.setAttribute('aria-label',label);
        node.innerHTML=main;
      };
      if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',renderScratchTitle,{once:true}); else renderScratchTitle();
      window.addEventListener('sm:language-changed',renderScratchTitle);
    </script>
  </main>
  <Mascot />
</BaseLayout>
