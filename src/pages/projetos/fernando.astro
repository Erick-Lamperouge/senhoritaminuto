---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Mascot from '../../components/Mascot.astro';
import FernandoTribute from '../../components/FernandoTribute.astro';
import FernandoInline from '../../components/FernandoInline.astro';
---
<BaseLayout title="FERNANDO — Senhorita Minuto" description="FERNANDO, simulador educacional de ACLS e PCR.">
  <Header />
  <main class="project-page project-page-refined project-page-standardized" data-page-title-key="fernando.pageTitle">
    <a class="back-link time-back-link" href="/" data-i18n="common.backTime">← Voltar no Tempo (Início)</a>

    <section class="project-hero-grid">
      <div class="project-hero-main">
        <h1>FERNANDO</h1>
        <p class="project-lead" data-i18n="fernando.lead">Simulador educacional para treinamento de parada cardiorrespiratória e raciocínio em ACLS.</p>
        <div class="project-actions emphasis-actions">
          <a class="button primary action-main" href="https://fernando-acls.vercel.app/" target="_blank" rel="noreferrer" data-i18n="common.openSimulator">Abrir simulador ↗</a>
          <a class="button secondary" href="#sobre-projeto" data-i18n="common.aboutProject">Sobre o projeto</a>
        </div>
      </div>

      <aside class="project-showcase-slot" aria-label="Homenagem visual do projeto Fernando">
        <div class="showcase-shell showcase-fernando"><FernandoInline /></div>
      </aside>
    </section>

    <div class="fernando-hero top-metrics-shell">
      <div><span class="terminal-label" data-i18n="fernando.status">STATUS</span><strong data-i18n="fernando.statusValue">PRONTO</strong></div>
      <div><span class="terminal-label" data-i18n="fernando.focus">FOCO</span><strong>PCR · ACLS · 5H/5T</strong></div>
      <div><span class="terminal-label" data-i18n="fernando.experience">EXPERIÊNCIA</span><strong data-i18n="fernando.experienceValue">SIMULAÇÃO GUIADA</strong></div>
    </div>

    <div class="project-details" id="sobre-projeto">
      <section>
        <h2 data-i18n="fernando.about">Sobre o projeto</h2>
        <p data-i18n="fernando.aboutText">FERNANDO é um simulador educacional voltado ao treinamento de PCR e raciocínio em ACLS. O projeto foi pensado para apoiar aprendizagem prática, tomada de decisão e revisão estruturada de condutas em cenários críticos.</p>
      </section>
      <section>
        <h2 data-i18n="fernando.how">Como funciona</h2>
        <p data-i18n="fernando.howText">A experiência coloca o usuário diante de situações que exigem reconhecimento de ritmos, escolha de intervenções, administração de medicamentos e organização dos ciclos de atendimento, transformando conteúdo teórico em uma sequência de decisões.</p>
      </section>
    </div>

    <FernandoTribute />
  </main>
  <Mascot />
</BaseLayout>
