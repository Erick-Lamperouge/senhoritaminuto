---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Mascot from '../../components/Mascot.astro';
import { projects } from '../../config/projects';

const jackUpUrl = projects.jackUp.liveUrl.trim();
const hasLiveJackUp = jackUpUrl.length > 0;
---
<BaseLayout title="Jack-UP — Senhorita Minuto" description="Jack-UP, jogo educacional em inglês voltado à área da saúde e ao estudo de fraturas.">
  <Header />
  <main class="project-page project-page-refined project-page-standardized" data-page-title-key="jack.pageTitle">
    <a class="back-link time-back-link" href="/" data-i18n="common.backTime">← Voltar no Tempo (Início)</a>

    <section class="project-hero-grid">
      <div class="project-hero-main">
        <h1>Jack-UP</h1>
        <p class="project-lead" data-i18n="jack.lead">Um jogo educacional em inglês que leva conteúdos sobre fraturas para uma experiência interativa e jogável.</p>
        <div class="project-actions emphasis-actions">
          {hasLiveJackUp ? (<a class="button primary action-main" href="#jogar" data-i18n="common.goGame">Ir para o jogo</a>) : null}
          <a class="button secondary" href="#sobre-projeto" data-i18n="common.aboutProject">Sobre o projeto</a>
        </div>
      </div>

      <aside class="project-showcase-slot" aria-label="Espaço reservado para o mascote do Jack-UP">
        <div class="showcase-shell showcase-mascot-slot" data-project-mascot-slot="jack-up">
          <span class="mascot-slot-note" data-i18n="jack.mascotSoon">Mascote em breve</span>
        </div>
      </aside>
    </section>

    <div class="language-only-note" role="note">
      <span class="language-only-badge" aria-hidden="true">EN</span>
      <span data-i18n="jack.englishOnly">O jogo está disponível apenas em inglês.</span>
    </div>

    <div class="fernando-hero top-metrics-shell">
      <div><span class="terminal-label" data-i18n="jack.format">FORMATO</span><strong data-i18n="jack.formatValue">JOGO EDUCACIONAL</strong></div>
      <div><span class="terminal-label" data-i18n="jack.language">IDIOMA</span><strong data-i18n="jack.languageValue">APENAS INGLÊS</strong></div>
      <div><span class="terminal-label" data-i18n="jack.content">CONTEÚDO</span><strong data-i18n="jack.health">FRATURAS · SAÚDE</strong></div>
    </div>

    {hasLiveJackUp ? (
      <>
        <div class="play-here-callout" role="note" aria-label="Dá para jogar diretamente nesta página" data-i18n-aria="common.playHereAria">
          <span class="play-here-signal" aria-hidden="true"></span>
          <span class="play-here-copy">
            <strong data-i18n="common.playHere">Dá para jogar aqui</strong>
            <small data-i18n="common.playHereSub">Jogue sem sair do site</small>
          </span>
          <span class="play-here-arrow" aria-hidden="true">↓</span>
        </div>
        <div class="embed-shell jackup-shell top-embed-shell" id="jogar">
          <iframe src={jackUpUrl} title="Jack-UP" allowfullscreen loading="eager"></iframe>
        </div>
        <div class="embedded-secondary-action">
          <a class="text-link" href={jackUpUrl} target="_blank" rel="noreferrer" data-i18n="common.openOwn">Abrir em tela própria ↗</a>
        </div>
      </>
    ) : (
      <section class="integration-ready">
        <span class="eyebrow" data-i18n="jack.unavailable">INDISPONÍVEL NO MOMENTO</span>
        <h2 data-i18n="jack.unavailableTitle">O jogo ainda não está carregando nesta página.</h2>
        <p data-i18n="jack.unavailableText">Assim que a versão pública estiver disponível, o Jack-UP poderá ser jogado diretamente por aqui.</p>
      </section>
    )}

    <div class="project-details" id="sobre-projeto">
      <section>
        <h2 data-i18n="jack.about">Sobre o projeto</h2>
        <p data-i18n="jack.aboutText">Jack-UP é um jogo educacional em inglês desenvolvido para explorar conteúdos da área da saúde de forma interativa. Ao longo da experiência, o jogador encontra perguntas e desafios relacionados a fraturas, avançando pelo jogo à medida que responde às situações apresentadas.</p>
      </section>
      <section>
        <h2 data-i18n="jack.experience">A experiência</h2>
        <p data-i18n="jack.experienceText">O projeto combina aprendizagem e mecânicas de jogo em uma experiência simples e acessível, utilizando o inglês tanto na interface quanto no conteúdo apresentado ao jogador.</p>
      </section>
    </div>
  </main>
  <Mascot />
</BaseLayout>
