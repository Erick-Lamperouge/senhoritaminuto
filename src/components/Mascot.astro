---
import '../styles/mascot.css';
---

<div class="mascot-zone" aria-live="polite">
  <div class="time-portal portal-left" id="portalLeft" aria-hidden="true"><span></span></div>
  <div class="time-portal portal-right" id="portalRight" aria-hidden="true"><span></span></div>

  <div class="climb-route climb-route-left" id="climbRouteLeft" aria-hidden="true">
    <span class="hold h1"></span><span class="hold h2"></span><span class="hold h3"></span><span class="hold h4"></span>
    <span class="hold h5"></span><span class="hold h6"></span><span class="hold h7"></span><span class="hold h8"></span>
    <span class="top-platform"></span>
  </div>
  <div class="climb-route climb-route-right" id="climbRouteRight" aria-hidden="true">
    <span class="hold h1"></span><span class="hold h2"></span><span class="hold h3"></span><span class="hold h4"></span>
    <span class="hold h5"></span><span class="hold h6"></span><span class="hold h7"></span><span class="hold h8"></span>
    <span class="top-platform"></span>
  </div>

  <div class="wind-streaks" id="windStreaks" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="rewind-clock-badge" id="rewindClock" aria-hidden="true">
    <span class="clock-face"></span>
    <span class="clock-hand hour"></span>
    <span class="clock-hand minute"></span>
  </div>

  <div class="mine-event" id="mineEvent" aria-hidden="true">
    <span class="mine-body"></span>
    <span class="mine-prong p1"></span><span class="mine-prong p2"></span><span class="mine-prong p3"></span>
  </div>
  <div class="mine-blast" id="mineBlast" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <div class="music-notes" id="musicNotes" aria-hidden="true">
    <span>♪</span><span>♫</span><span>♪</span>
  </div>

  <a class="project-token" id="projectToken" href="/#projetos">
    <span class="token-label">PROJETO ENCONTRADO</span>
    <strong id="projectTokenName">clique para olhar</strong>
  </a>

  <div class="mascot-traveler" id="mascotTraveler" data-mode="walk" data-side="left">
    <div class="mascot-balloon" aria-hidden="true"><span>◌</span></div>
    <div class="mascot-parachute" aria-hidden="true"><span class="canopy"></span><span class="line l1"></span><span class="line l2"></span><span class="line l3"></span></div>
    <div class="mascot-speech" id="mascotSpeech" role="status" hidden></div>

    <button class="mascot-button" id="mascotButton" type="button" aria-label="Conversar com a Senhorita Minuto">
      <span class="mascot-skate" aria-hidden="true">
        <span class="skate-board"></span>
        <span class="skate-wheel one"></span>
        <span class="skate-wheel two"></span>
      </span>
      <span class="mascot-guitar" aria-hidden="true">
        <span class="g-body"></span><span class="g-neck"></span><span class="g-head"></span>
      </span>

      <svg class="mascot-svg" viewBox="0 0 92 108" role="img" aria-label="Senhorita Minuto, assistente digital pixelada">
        <g shape-rendering="crispEdges">
          <path class="hair-bow-wing" d="M63 12h5V8h6v4h4v6h-4v4h-6v-4h-5z" />
          <path class="hair-bow-wing" d="M61 13h-4v-3h-5v4h5v4h4z" />
          <path class="hair-bow-knot" d="M60 12h5v7h-5z" />

          <path class="hair-back" d="M18 30h56v48H18z" />
          <path class="body" d="M26 20h40v8h8v50h-8v10H26V78h-8V28h8z" />
          <path class="screen" d="M30 32h32v30H30z" />
          <path class="back-screen" d="M30 32h32v30H30z" />
          <path class="eye" d="M35 42h7v7h-7zM51 42h7v7h-7z" />
          <path class="mouth" d="M40 54h13v4H40z" />
          <path class="panel" d="M31 68h30v8H31z" />
          <path class="button-one" d="M35 70h5v4h-5z" />
          <path class="button-two" d="M44 70h5v4h-5z" />
          <path class="button-three" d="M53 70h5v4h-5z" />
          <path class="arm arm-left" d="M10 52h8v8h-8zM4 60h10v7H4z" />
          <path class="arm arm-right" d="M74 52h8v8h-8zM78 60h10v7H78z" />

          <g class="leg-group leg-left">
            <path class="leg" d="M31 88h8v12h-8z" />
            <path class="shoe" d="M24 98h16v7H24z" />
          </g>
          <g class="leg-group leg-right">
            <path class="leg" d="M54 88h8v12h-8z" />
            <path class="shoe" d="M53 98h16v7H53z" />
          </g>

          <path class="clock" d="M43 24h7v3h-7zM45 21h3v8h-3z" />
        </g>
      </svg>
    </button>
  </div>
</div>

<script>
  import '../scripts/mascot.js';
</script>
