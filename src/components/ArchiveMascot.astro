<div class="archive-mascot" id="archive-mascot">
  <span class="archive-kicker" data-i18n="blogs.mascot.name">ARQUIVISTA / 01</span>
  <button class="archive-character" id="archive-character" type="button" data-i18n-aria="blogs.mascot.button" aria-label="Conversar com o arquivista">
    <svg viewBox="0 0 128 128" role="img" aria-hidden="true" shape-rendering="crispEdges">
      <path fill="#202f31" d="M15 115h99v6H15z"/>
      <path fill="#6db8ad" d="M37 21h48v8h10v55H85v12H37V84H27V29h10z"/>
      <path fill="#f0cf8d" d="M31 18h54v8h11v10H20V26h11zM45 10h24v8H45z"/>
      <path fill="#121a1c" d="M39 39h44v32H39z"/>
      <path fill="#e5ad55" class="archive-eye" d="M47 48h9v10h-9zM67 48h9v10h-9z"/>
      <path fill="#6db8ad" d="M53 63h18v4H53z"/>
      <path fill="#f0cf8d" d="M44 96h12v12H44zM68 96h12v12H68z"/>
      <path fill="#e5ad55" d="M37 108h23v8H37zM65 108h23v8H65z"/>
      <path fill="#6db8ad" d="M15 70h12v18H15zM95 70h12v18H95z"/>
      <path fill="#f4ebd7" d="M34 78h25l5 4 5-4h25v25H69l-5 4-5-4H34z"/>
      <path fill="#a66e35" d="M34 78h4v25h-4zM90 78h4v25h-4zM62 82h4v25h-4z"/>
      <path fill="#879d97" d="M43 86h13v3H43zM43 93h13v3H43zM73 86h13v3H73zM73 93h13v3H73z"/>
      <path fill="#e5ad55" d="M15 82h9v11h-9zM99 82h9v11h-9z"/>
    </svg>
  </button>
  <p class="archive-speech" id="archive-speech" role="status" aria-live="polite" data-i18n="blogs.mascot.1" hidden>Bem-vindo ao arquivo! Escolha uma leitura para começar.</p>
</div>
<script>
  import {MASCOT_TIMING,readingDuration} from '../scripts/mascot/timing.js';
  import {TimerGroup} from '../scripts/mascot/timers.js';
  const root=document.querySelector<HTMLElement>('#archive-mascot');
  const character=document.querySelector<HTMLButtonElement>('#archive-character');
  const speech=document.querySelector<HTMLElement>('#archive-speech');
  const timers=new TimerGroup();
  const tx=(key:string,fallback:string)=>(window as any).SM_I18N?.t(key,fallback)??fallback;
  const entries=[
    {key:'blogs.mascot.greeting',text:'Senhorita Minuto, o arquivo está organizado. Qual leitura vamos apresentar hoje?',replyKey:'blogs.mascot.greetingReply',reply:'O primeiro universo é o Futebolando! As outras estantes vão ganhar vida aos poucos.'},
    {key:'blogs.mascot.question',text:'Minuto, cada blog tem seu próprio tempo de leitura, não é?',replyKey:'blogs.mascot.questionReply',reply:'Exatamente. Aqui eu abro a porta, mas cada publicação tem seu próprio mundo.'},
    {key:'blogs.mascot.2',text:'Cada assunto tem seu próprio universo. Eu cuido da porta de entrada.'},
    {key:'blogs.mascot.3',text:'O Futebolando está em prévia. Há regras, tática e números para explorar!'}
  ];
  let next=1,greeted=false,busy=false;
  const visible=()=>{const r=root?.getBoundingClientRect();return !!r&&r.bottom>0&&r.top<innerHeight&&document.visibilityState==='visible';};
  const hide=()=>{timers.clearAll();if(speech)speech.hidden=true;};
  function speak(entry:typeof entries[number],initial=false){
    if(!speech||busy||!visible())return;
    timers.clearAll();
    window.dispatchEvent(new CustomEvent('sm:project-bubble-open',{detail:{source:'archive'}}));
    const message=tx(entry.key,entry.text);
    speech.dataset.i18n=entry.key;speech.textContent=message;speech.hidden=false;
    const duration=readingDuration(message,{min:initial?MASCOT_TIMING.initialMinMs:MASCOT_TIMING.normalMinMs});
    timers.set(()=>{
      if(speech)speech.hidden=true;
      if(entry.replyKey&&entry.reply&&visible()){
        timers.set(()=>{if(!visible()||busy)return;const reply=tx(entry.replyKey!,entry.reply!);const replyDuration=readingDuration(reply);window.dispatchEvent(new CustomEvent('sm:interact',{detail:{target:'#archive-mascot',message:reply,duration:replyDuration,hold:replyDuration+900,mood:'happy'}}));},MASCOT_TIMING.speakerGapMs);
      }
    },duration);
  }
  function greet(){if(greeted||busy||!visible())return;greeted=true;speak(entries[0],true);}
  if(root&&character&&speech){
    const observer=new IntersectionObserver(entries=>{if(entries.some(e=>e.isIntersecting))greet();},{threshold:0.25});observer.observe(root);
    character.addEventListener('click',()=>{if(busy)return;greeted=true;speak(entries[next]);next=next===entries.length-1?1:next+1;});
    window.addEventListener('sm:minute-bubble-open',hide);
    window.addEventListener('sm:project-bubble-open',event=>{if(event instanceof CustomEvent&&event.detail?.source!=='archive')hide();});
    window.addEventListener('sm:interaction-state',event=>{if(event instanceof CustomEvent){busy=event.detail?.active===true;character.setAttribute('aria-disabled',String(busy));if(busy)hide();}});
    window.addEventListener('sm:language-changed',()=>{hide();greeted=false;timers.set(greet,350);});
    document.addEventListener('visibilitychange',()=>{if(document.hidden)hide();});
    window.addEventListener('pagehide',()=>{hide();observer.disconnect();},{once:true});
    timers.set(greet,650);
  }
</script>
