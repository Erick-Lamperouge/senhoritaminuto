---
import '../styles/project-mascot.css';
---
<div class="jack-mascot project-character-scene" id="jack-mascot" data-project-mascot="jack-up" data-mascot-species="alligator" data-pose="idle" data-motion-paused="false">
  <button class="jack-character project-character" id="jack-character" type="button" aria-label="Conversar com Jack" data-i18n-aria="jack.mascot.button">
    <svg viewBox="-10 -24 180 176" aria-hidden="true" focusable="false" shape-rendering="crispEdges">
      <path fill="#25363a" opacity=".65" d="M14 141h132v5H14z"/>
      <g class="jack-body">
        <g class="jack-tail"><path fill="#122e69" d="M52 104H30v-7H19v10H10v11h9v9h23v-5h20v-18z"/><path fill="#2462be" d="M48 108H29v-7H20v14h8v7h19v-6h10v-8z"/></g>
        <path fill="#142e61" d="M45 65h53v10h10v39H98v15H44v-15H35V75h10z"/>
        <path fill="#2873cf" d="M47 69h48v10h9v33H94v14H47v-14h-8V79h8z"/>
        <path fill="#cddce4" d="M49 80h43v8h7v25H43V88h6z"/>
        <path fill="#f4f3e7" d="M54 79h32v10h8v20H49V89h5z"/>
        <path fill="#dc852f" d="M49 87h5v22h-5zM89 87h5v22h-5z"/>
        <path fill="#286ac5" d="M62 94h18v5H68v7h-6z"/>
        <g class="jack-leg-left"><path fill="#c9d9e2" d="M43 113h26v14H43z"/><path fill="#14336d" d="M45 127h24v8H37v5h35v-13z"/><path fill="#4b92e0" d="M42 135h7v5h-7zM53 135h6v5h-6z"/><g class="jack-bandage"><path fill="#f3ebd4" d="M44 125h27v9H44z"/><path fill="#8d9b9a" d="M46 127h23v2H46zM46 131h23v2H46z"/></g></g>
        <g class="jack-leg-right"><path fill="#c9d9e2" d="M73 113h26v14H73z"/><path fill="#14336d" d="M75 127h24v8h12v5H73v-13z"/><path fill="#4b92e0" d="M90 135h7v5h-7zM101 135h6v5h-6z"/></g>
        <g class="jack-head">
          <path fill="#112a5e" d="M37 29h56v8h12v10h35v7h10v20h-10v8H72v-5H46V67H35V39h2z"/>
          <path fill="#216bce" d="M42 33h47v8h12v11h36v5h8v14h-9v7H73v-6H49V62H39V40h3z"/>
          <path fill="#468fe6" d="M44 35h43v8h11v13h38v7h-43v-5H43z"/>
          <path fill="#183c88" d="M51 62h32v7h48v5H75v-5H51z"/>
          <path fill="#f4f3e7" d="M54 61h7v7h-7zM72 66h7v7h-7zM88 69h8v6h-8zM115 69h8v6h-8z"/>
          <g class="jack-eye"><path fill="#e8f3ec" d="M51 43h21v14H51z"/><path fill="#123e56" d="M62 46h7v8h-7z"/><path fill="#56dcc7" d="M62 47h3v3h-3z"/></g>
          <path fill="#0f2d66" d="M49 40h27v5H49zM124 56h5v5h-5zM136 57h4v4h-4z"/>
          <g class="jack-cap"><path fill="#26394d" d="M35 22h9V11h43v7h10v10h15v7H35z"/><path fill="#d6e4ec" d="M39 22h10V15h35v6h10v11H39z"/><path fill="#f8faf4" d="M49 15h30v5H49zM43 22h7v7h-7zM76 28h30v5H76z"/></g>
        </g>
        <g class="jack-ball-arm"><path fill="#142e61" d="M35 80H25v23h12v-9h10V80z"/><path fill="#2873cf" d="M28 83h10v12H28z"/><path fill="#3985d6" d="M37 95h10v9H37z"/></g>
        <g class="jack-free-arm"><path fill="#142e61" d="M102 79h12v14h-7v15H95V91h7z"/><path fill="#2873cf" d="M104 83h7v12h-7zM99 97h8v9h-8z"/></g>
        <g class="jack-ball"><path fill="#713e1d" d="M14 89h7v-7h22v7h7v20h-7v7H21v-7h-7z"/><path fill="#f29a38" d="M18 91h6v-5h16v5h6v16h-6v5H24v-5h-6z"/><path stroke="#713e1d" stroke-width="2" fill="none" d="M32 85v28M17 99h30M22 88q13 11 20 22M42 88q-13 11-20 22"/></g>
        <g class="jack-crutch"><path fill="#c4d4d8" d="M108 79h32v6h-32zM111 85h5v38h-5zM132 85h5v38h-5zM116 120h16v6h-16zM122 126h5v13h-5z"/><path fill="#668781" d="M116 98h16v5h-16zM119 138h11v5h-11z"/></g>
      </g>
    </svg>
  </button>
  <div class="jack-speech project-speech" id="jack-speech" role="status" aria-live="polite" data-i18n="jack.mascot.hello" hidden>Minuto, vamos preparar mais uma rodada de aprendizado?</div>
  <div class="project-scene-controls"><span class="jack-mascot-kicker" data-i18n="jack.mascot.name">JACK / COMPANHEIRO DE TREINO</span><button class="project-motion" data-mascot-motion type="button" aria-pressed="false" data-i18n="mascot.motion.pause" hidden>Pausar movimentos</button></div>
</div>
<script>
  import {createProjectDialogue} from '../scripts/mascot/project-dialogue.js';
  import {JACK_POSES} from '../scripts/mascot/project-scenes.js';
  createProjectDialogue({
    root:document.querySelector('#jack-mascot'),character:document.querySelector('#jack-character'),speech:document.querySelector('#jack-speech'),source:'jack-up',
    poses:JACK_POSES,ambient:['dribble','cap','limp'],initialDelay:750,
    entries:[
      {key:'jack.mascot.hello',text:'Minuto, vamos preparar mais uma rodada de aprendizado?',replyKey:'jack.mascot.helloReply',reply:'Vamos, Jack! No seu jogo, cada desafio é uma chance de aprender.',pose:'cap'},
      {key:'jack.mascot.ball',text:'Minuto, eu trouxe foco, disciplina e uma bola!',replyKey:'jack.mascot.ballReply',reply:'E eu trouxe organização. Agora vai!',pose:'dribble'},
      {key:'jack.mascot.hat',text:'Quer jogar ou veio só admirar meu boné?',pose:'cap'},
      {key:'jack.mascot.crutch',text:'Se eu aparecer de muleta, é uma cena de demonstração.',replyKey:'jack.mascot.crutchReply',reply:'Tudo bem, Jack. Cuide-se e vamos aprender sem pressa.',pose:'limp'},
      {key:'jack.mascot.question',text:'Senhorita Minuto, dá para voltar no tempo quando erramos uma resposta?',replyKey:'jack.mascot.questionReply',reply:'No treino podemos tentar de novo. O importante é entender o porquê da resposta.',pose:'react'},
      {key:'jack.mascot.study',text:'Uma pausa para pensar vale mais do que responder com pressa.',pose:'react'}
    ]
  });
</script>
