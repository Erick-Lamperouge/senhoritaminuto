---
interface Props { src:string;title:string;openUrl:string;jack?:boolean; }
const {src,title,openUrl,jack=false}=Astro.props;
---
<div class="play-here-callout" role="note" aria-label="Dá para jogar diretamente nesta página" data-i18n-aria="common.playHereAria">
  <span class="play-here-signal" aria-hidden="true"></span>
  <span class="play-here-copy"><strong data-i18n="common.playHere">Dá para jogar aqui</strong><small data-i18n="common.playHereSub">Jogue sem sair do site</small></span>
  <span class="play-here-arrow" aria-hidden="true">↓</span>
</div>
<div class:list={['embed-shell','top-embed-shell',{'jackup-shell':jack}]} id="jogar">
  <iframe src={src} title={title} allowfullscreen loading="eager" referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>
<div class="embedded-secondary-action"><a class="text-link" href={openUrl} target="_blank" rel="noreferrer" data-i18n="common.openOwn">Abrir em tela própria ↗</a></div>
