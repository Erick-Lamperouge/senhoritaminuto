<div class="scratch-cat-scene" id="scratchCatScene" aria-label="Interação entre um gato pixelado e a Senhorita Minuto">
  <button class="scratch-cat" id="scratchCat" type="button" aria-label="Interagir com o gato do Projeto Scratch">
    <img class="cat-base" src="/assets/characters/scratch-cat-pixel.png" alt="Gato laranja em pixel art" draggable="false" />
  </button>
  <div class="cat-bubble" id="catBubble" hidden></div>
  <div class="time-wand" id="timeWand" aria-hidden="true">
    <span class="wand-stick"></span>
    <span class="wand-star">✦</span>
    <span class="wand-spark s1">✦</span>
    <span class="wand-spark s2">✧</span>
    <span class="wand-spark s3">✦</span>
  </div>
  <div class="cat-portal" id="catPortal" aria-hidden="true"><img src="/assets/props/scratch-portal.png" alt="" draggable="false" /></div>
  <div class="cat-rewind" id="catRewind" aria-hidden="true">REWIND&nbsp;&nbsp;00:03 ← 00:02 ← 00:01</div>
</div>

<style>
  .scratch-cat-scene{position:relative;width:190px;height:180px;flex:0 0 190px;align-self:center;margin:0 auto}
  .scratch-cat{position:absolute;left:50%;bottom:12px;width:136px;height:136px;transform:translateX(-50%);border:0;background:transparent;padding:0;cursor:pointer;z-index:4;transition:transform .28s ease,filter .28s ease}
  .scratch-cat:hover{transform:translateX(-50%) translateY(-4px)}
  .scratch-cat .cat-base{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(4px 5px 0 rgba(0,0,0,.22));pointer-events:none;user-select:none}
  .scratch-cat.idle{animation:cat-idle 3.2s ease-in-out infinite}
  .scratch-cat.alert{animation:cat-alert .7s steps(2,end) 2}
  @keyframes cat-idle{0%,100%{transform:translateX(-50%) translateY(0) rotate(0deg)}50%{transform:translateX(-50%) translateY(-3px) rotate(.5deg)}}
  @keyframes cat-alert{0%,100%{transform:translateX(-50%) translateY(0) scale(1)}50%{transform:translateX(-50%) translateY(-5px) scale(1.035)}}

  .cat-bubble{position:absolute;left:-18px;bottom:132px;max-width:210px;width:max-content;padding:10px 12px;background:#f2e4c4;color:#25231d;border:3px solid #282c2b;box-shadow:4px 4px 0 rgba(0,0,0,.3);font-size:.72rem;line-height:1.4;z-index:12}
  .cat-bubble::after{content:'';position:absolute;right:40px;bottom:-9px;width:12px;height:12px;background:#f2e4c4;border-right:3px solid #282c2b;border-bottom:3px solid #282c2b;transform:rotate(45deg)}

  .time-wand{position:absolute;left:8px;bottom:44px;width:84px;height:84px;opacity:0;z-index:10;transform:translateX(-20px) rotate(-24deg);transition:opacity .22s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
  .time-wand.active{opacity:1;transform:translateX(38px) rotate(6deg)}
  .wand-stick{position:absolute;left:12px;top:48px;width:50px;height:6px;background:linear-gradient(90deg,#b88943,#e6c27e);border:2px solid #3c3120;border-radius:99px;transform:rotate(-32deg);transform-origin:left center;box-shadow:0 0 0 1px rgba(255,255,255,.05) inset}
  .wand-star{position:absolute;left:49px;top:16px;font-size:1.8rem;line-height:1;color:#f0cf8d;text-shadow:0 0 10px rgba(240,207,141,.45)}
  .wand-spark{position:absolute;font-size:.85rem;color:#7fd2c4;opacity:0}
  .time-wand.active .wand-spark{animation:wand-spark 1s ease-out forwards}
  .wand-spark.s1{left:56px;top:42px}.wand-spark.s2{left:66px;top:10px;animation-delay:.15s}.wand-spark.s3{left:34px;top:22px;animation-delay:.28s}
  @keyframes wand-spark{0%{opacity:0;transform:scale(.3)}30%{opacity:1}100%{opacity:0;transform:translateY(-14px) scale(1.25)}}

  .cat-portal{position:absolute;left:50%;bottom:14px;width:118px;height:118px;opacity:0;transform:translateX(-50%) scale(.18);transition:opacity .28s ease,transform .68s cubic-bezier(.1,.8,.2,1);overflow:visible;z-index:5}
  .cat-portal.active{opacity:1;transform:translateX(-50%) scale(1)}
  .cat-portal img{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;user-select:none;pointer-events:none;mix-blend-mode:screen}

  .cat-rewind{position:absolute;left:-6px;bottom:8px;padding:6px 9px;background:rgba(12,17,18,.94);border:1px solid rgba(109,184,173,.5);color:#f0cf8d;font-size:.58rem;letter-spacing:.04em;opacity:0;z-index:11;white-space:nowrap}
  .cat-rewind.active{animation:rewind-label 2.3s steps(4,end) both}
  @keyframes rewind-label{0%{opacity:0}14%,84%{opacity:1}100%{opacity:0}}

  .scratch-cat.rewinding{animation:cat-rewind 2s steps(6,end) both}
  .scratch-cat.portal-travel{animation:cat-portal-travel 2.4s cubic-bezier(.2,.8,.2,1) both}
  @keyframes cat-rewind{0%{filter:none}25%{filter:hue-rotate(60deg)}50%{filter:hue-rotate(-70deg) contrast(1.18)}75%{filter:hue-rotate(25deg)}100%{filter:none}}
  @keyframes cat-portal-travel{0%{transform:translateX(-50%) scale(1);opacity:1}30%{transform:translateX(calc(-50% - 12px)) scale(.93);opacity:.78}50%{transform:translateX(calc(-50% - 4px)) scale(.42);opacity:.2}68%{transform:translateX(calc(-50% + 5px)) scale(.24);opacity:.08}100%{transform:translateX(-50%) scale(1);opacity:1}}

  @media(max-width:720px){
    .scratch-cat-scene{width:148px;height:130px;flex-basis:148px}
    .scratch-cat{width:108px;height:108px}
    .cat-bubble{left:-76px;bottom:104px;max-width:190px;font-size:.68rem}
    .cat-portal{width:78px;height:78px;bottom:8px}
    .time-wand{width:62px;height:62px;left:-2px;bottom:28px}
    .wand-stick{width:38px;height:5px;left:8px;top:36px}
    .wand-star{left:38px;top:9px;font-size:1.3rem}
    .cat-rewind{left:-26px;bottom:0;font-size:.5rem}
  }
</style>

<script>
  const scene=document.querySelector('#scratchCatScene');
  const cat=document.querySelector('#scratchCat');
  const bubble=document.querySelector('#catBubble');
  const wand=document.querySelector('#timeWand');
  const portal=document.querySelector('#catPortal');
  const rewind=document.querySelector('#catRewind');

  if(scene instanceof HTMLElement&&cat instanceof HTMLButtonElement&&bubble instanceof HTMLElement&&wand instanceof HTMLElement&&portal instanceof HTMLElement&&rewind instanceof HTMLElement){
    const tx=(key,fallback)=>window.SM_I18N?.t?.(key,fallback) ?? fallback;
    const dialogues=()=>[
      {cat:tx('cat.1','Os gatos vão dominar o mundo.'),minute:tx('cat.1r','Não nesta linha do tempo.'),mood:'evil',power:true},
      {cat:tx('cat.2','O futuro pertence aos gatos.'),minute:tx('cat.2r','Só se eu deixar. E eu trouxe a varinha.'),mood:'evil',power:true},
      {cat:tx('cat.3','Quando o tempo acabar, os gatos ainda vão ganhar.'),minute:tx('cat.3r','Eu ainda posso reiniciar esta fase.'),mood:'evil',power:true},
      {cat:tx('cat.4','Só preciso de mais alguns minutos para dominar tudo.'),minute:tx('cat.4r','Minutos são justamente a minha especialidade.'),mood:'happy',power:false}
    ];
    const clickLines=()=>[
      tx('cat.click1','Miau.'),tx('cat.click2','Você não viu nada.'),tx('cat.click3','A revolução felina continua.'),tx('cat.click4','O plano está adiantado alguns minutos.')
    ];
    let catClicks=0, sequenceTimer=0, bubbleTimer=0, busy=false;
    cat.classList.add('idle');

    const inView=()=>{const r=scene.getBoundingClientRect();return r.bottom>0&&r.top<window.innerHeight&&r.right>0&&r.left<window.innerWidth;};
    const showCat=(message,duration=3000)=>{bubble.textContent=message;bubble.hidden=false;window.clearTimeout(bubbleTimer);bubbleTimer=window.setTimeout(()=>{bubble.hidden=true;},duration);};
    const interactMinute=(message,{mood='happy',power=false,hold=7600,duration=3800}={})=>{
      window.dispatchEvent(new CustomEvent('sm:interact',{detail:{target:'#scratchCatScene',message,duration,mood,power,hold}}));
    };
    const scheduleNext=()=>{window.clearTimeout(sequenceTimer);sequenceTimer=window.setTimeout(runScene,17000+Math.random()*13000);};

    const magicReset=()=>{
      wand.classList.add('active');
      portal.classList.add('active');
      rewind.classList.add('active');
      cat.classList.remove('idle');
      cat.classList.add('rewinding','portal-travel');
      window.dispatchEvent(new CustomEvent('sm:rewind',{detail:{duration:2500,power:true}}));
      window.setTimeout(()=>showCat(tx('cat.back','Ah não... eu voltei pro passado.'),3200),1900);
      window.setTimeout(()=>{
        wand.classList.remove('active');portal.classList.remove('active');rewind.classList.remove('active');cat.classList.remove('rewinding','portal-travel');cat.classList.add('idle');busy=false;
      },2850);
    };

    function runScene(){
      if(busy||!inView()){scheduleNext();return;}
      busy=true;
      const list=dialogues();
      const d=list[Math.floor(Math.random()*list.length)];
      cat.classList.add('alert');
      showCat(d.cat,3600);
      window.setTimeout(()=>cat.classList.remove('alert'),1500);
      window.setTimeout(()=>interactMinute(d.minute,{mood:d.mood,power:d.power,hold:9000,duration:4000}),2400);
      window.setTimeout(magicReset,5700);
      scheduleNext();
    }

    window.setTimeout(runScene,8200);

    cat.addEventListener('click',()=>{
      if(busy)return;
      catClicks+=1;
      const lines=clickLines();
      showCat(lines[(catClicks-1)%lines.length],2400);
      if(catClicks%3===0){
        window.setTimeout(()=>interactMinute(tx('cat.heard','Eu ouvi isso.'),{mood:'happy',power:false,hold:4200,duration:2400}),700);
      }
    });

    window.addEventListener('pagehide',()=>{window.clearTimeout(sequenceTimer);window.clearTimeout(bubbleTimer);},{once:true});
  }
</script>
