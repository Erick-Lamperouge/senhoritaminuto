<div class="scratch-cat-scene" id="scratchCatScene" aria-label="Interação entre um gato pixelado e a Senhorita Minuto">
  <button class="scratch-cat" id="scratchCat" type="button" aria-label="Interagir com o gato do Projeto Scratch">
    <img src="/assets/characters/scratch-cat-pixel.png" alt="Gato laranja em pixel art" draggable="false" />
  </button>

  <div class="cat-bubble" id="catBubble" hidden></div>

  <div class="time-wand" id="timeWand" aria-hidden="true">
    <span class="wand-star">✦</span>
    <span class="wand-stick"></span>
    <span class="spark s1">✦</span>
    <span class="spark s2">✧</span>
    <span class="spark s3">✦</span>
  </div>

  <div class="cat-portal" id="catPortal" aria-hidden="true"><span></span></div>
  <div class="cat-rewind" id="catRewind" aria-hidden="true">REWIND&nbsp;&nbsp;00:03 ← 00:02 ← 00:01</div>
</div>

<style>
  .scratch-cat-scene{position:relative;width:190px;height:160px;flex:0 0 190px;align-self:flex-end;margin-bottom:0}
  .scratch-cat{position:absolute;right:4px;bottom:0;width:138px;height:138px;border:0;background:transparent;padding:0;cursor:pointer;z-index:4;transition:transform .28s ease,filter .28s ease}
  .scratch-cat:hover{transform:translateY(-3px)}
  .scratch-cat img{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;filter:drop-shadow(4px 5px 0 rgba(0,0,0,.2));pointer-events:none;user-select:none}
  .scratch-cat.idle{animation:cat-idle 3.2s ease-in-out infinite}
  .scratch-cat.alert{animation:cat-alert .7s steps(2,end) 2}
  @keyframes cat-idle{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-2px) rotate(.4deg)}}
  @keyframes cat-alert{50%{transform:translateY(-4px) scale(1.025)}}

  .cat-bubble{position:absolute;left:-34px;bottom:122px;width:218px;padding:10px 12px;background:#f2e4c4;color:#25231d;border:3px solid #282c2b;box-shadow:4px 4px 0 rgba(0,0,0,.3);font-size:.72rem;line-height:1.4;z-index:12}
  .cat-bubble::after{content:'';position:absolute;right:36px;bottom:-9px;width:12px;height:12px;background:#f2e4c4;border-right:3px solid #282c2b;border-bottom:3px solid #282c2b;transform:rotate(45deg)}

  .time-wand{position:absolute;left:8px;bottom:36px;width:88px;height:64px;opacity:0;z-index:10;transform:translateX(-26px) rotate(-18deg);transition:opacity .25s ease,transform .9s cubic-bezier(.2,.8,.2,1)}
  .time-wand.active{opacity:1;transform:translateX(34px) rotate(8deg)}
  .wand-star{position:absolute;right:0;top:0;color:#f0cf8d;font-size:1.8rem;text-shadow:0 0 12px rgba(240,207,141,.6)}
  .wand-stick{position:absolute;right:23px;top:27px;width:48px;height:4px;background:#d5b36f;border:2px solid #3b3020;transform:rotate(-33deg);transform-origin:right center}
  .spark{position:absolute;color:#6db8ad;font-size:.85rem;opacity:0}.time-wand.active .spark{animation:spark-pop 1.1s ease-out forwards}.spark.s1{right:2px;top:29px}.spark.s2{right:22px;top:-7px;animation-delay:.18s}.spark.s3{right:-8px;top:8px;animation-delay:.34s}
  @keyframes spark-pop{0%{opacity:0;transform:scale(.3)}35%{opacity:1}100%{opacity:0;transform:translateY(-14px) scale(1.25)}}

  .cat-portal{position:absolute;right:24px;bottom:18px;width:92px;height:92px;opacity:0;transform:scale(.18);border:4px solid rgba(229,173,85,.86);border-radius:50%;box-shadow:0 0 0 5px rgba(109,184,173,.18),0 0 18px rgba(229,173,85,.55),inset 0 0 20px rgba(109,184,173,.32);transition:opacity .28s ease,transform .64s cubic-bezier(.1,.8,.2,1);overflow:hidden;z-index:5}
  .cat-portal::before,.cat-portal::after{content:'';position:absolute;inset:9px;border:2px dashed rgba(240,207,141,.78);border-radius:50%;animation:portal-spin 1.3s linear infinite}.cat-portal::after{inset:20px 13px;border-color:rgba(109,184,173,.82);animation-direction:reverse;animation-duration:.9s}.cat-portal span{position:absolute;inset:26px 18px;background:radial-gradient(circle,rgba(244,235,215,.34),rgba(109,184,173,.08) 46%,transparent 72%);border-radius:50%}.cat-portal.active{opacity:1;transform:scale(1)}
  @keyframes portal-spin{to{transform:rotate(360deg)}}

  .cat-rewind{position:absolute;left:-12px;bottom:12px;padding:6px 9px;background:rgba(12,17,18,.94);border:1px solid rgba(109,184,173,.5);color:#f0cf8d;font-size:.58rem;letter-spacing:.04em;opacity:0;z-index:11;white-space:nowrap}.cat-rewind.active{animation:rewind-label 2.3s steps(4,end) both}
  @keyframes rewind-label{0%{opacity:0}14%,84%{opacity:1}100%{opacity:0}}

  .scratch-cat.rewinding{animation:cat-rewind 2s steps(6,end) both}
  .scratch-cat.portal-travel{animation:cat-portal-travel 2.4s cubic-bezier(.2,.8,.2,1) both}
  @keyframes cat-rewind{0%{filter:none}25%{filter:hue-rotate(60deg)}50%{filter:hue-rotate(-70deg) contrast(1.18)}75%{filter:hue-rotate(25deg)}100%{filter:none}}
  @keyframes cat-portal-travel{0%{transform:translateX(0) scale(1);opacity:1}30%{transform:translateX(-12px) scale(.93);opacity:.78}50%{transform:translateX(-4px) scale(.42);opacity:.2}68%{transform:translateX(5px) scale(.24);opacity:.08}100%{transform:translateX(0) scale(1);opacity:1}}

  @media(max-width:720px){.scratch-cat-scene{width:138px;height:126px;flex-basis:138px}.scratch-cat{width:104px;height:104px}.cat-bubble{left:-72px;bottom:100px;width:188px;font-size:.68rem}.cat-portal{width:68px;height:68px;right:18px;bottom:12px}.cat-rewind{left:-26px;bottom:0;font-size:.5rem}}
</style>

<script>
  const scene=document.querySelector('#scratchCatScene');
  const cat=document.querySelector('#scratchCat');
  const bubble=document.querySelector('#catBubble');
  const wand=document.querySelector('#timeWand');
  const portal=document.querySelector('#catPortal');
  const rewind=document.querySelector('#catRewind');

  if(scene instanceof HTMLElement&&cat instanceof HTMLButtonElement&&bubble instanceof HTMLElement&&wand instanceof HTMLElement&&portal instanceof HTMLElement&&rewind instanceof HTMLElement){
    const dialogues=[
      {cat:'Os gatos vão dominar o mundo.',minute:'Não nesta linha do tempo.'},
      {cat:'O futuro pertence aos gatos.',minute:'Só se eu deixar. E eu trouxe a varinha.'},
      {cat:'Quando o tempo acabar, os gatos ainda vão ganhar.',minute:'Eu ainda posso reiniciar esta fase.'},
      {cat:'Só preciso de mais alguns minutos para dominar tudo.',minute:'Minutos são justamente a minha especialidade.'},
      {cat:'Você não pode vigiar todas as linhas do tempo.',minute:'Talvez não. Mas esta aqui eu consigo.'}
    ];
    const clickLines=['Miau.','Você não viu nada.','A revolução felina continua.','O plano está adiantado alguns minutos.'];
    let catClicks=0;
    let sequenceTimer=0;
    let bubbleTimer=0;
    let busy=false;
    cat.classList.add('idle');

    const showCat=(text,duration=3000)=>{
      bubble.textContent=text;
      bubble.hidden=false;
      window.clearTimeout(bubbleTimer);
      bubbleTimer=window.setTimeout(()=>{bubble.hidden=true;},duration);
    };

    const minuteSay=(message,duration=3600)=>{
      window.dispatchEvent(new CustomEvent('sm:say',{detail:{message,duration}}));
    };

    const scheduleNext=()=>{
      window.clearTimeout(sequenceTimer);
      sequenceTimer=window.setTimeout(runScene,17000+Math.random()*13000);
    };

    const magicReset=()=>{
      busy=true;
      cat.classList.remove('idle');
      wand.classList.add('active');
      portal.classList.add('active');
      rewind.classList.add('active');
      cat.classList.add('rewinding','portal-travel');
      window.dispatchEvent(new CustomEvent('sm:rewind',{detail:{duration:2200}}));
      window.setTimeout(()=>showCat('Ah não... eu voltei pro passado.',3200),1900);
      window.setTimeout(()=>{
        wand.classList.remove('active');
        portal.classList.remove('active');
        rewind.classList.remove('active');
        cat.classList.remove('rewinding','portal-travel');
        cat.classList.add('idle');
        busy=false;
      },2650);
    };

    function runScene(){
      if(busy){scheduleNext();return;}
      const d=dialogues[Math.floor(Math.random()*dialogues.length)];
      cat.classList.add('alert');
      showCat(d.cat,3600);
      window.setTimeout(()=>cat.classList.remove('alert'),1500);
      window.setTimeout(()=>minuteSay(d.minute,4000),2500);
      window.setTimeout(magicReset,5900);
      scheduleNext();
    }

    window.setTimeout(runScene,4800);

    cat.addEventListener('click',()=>{
      if(busy)return;
      catClicks+=1;
      showCat(clickLines[(catClicks-1)%clickLines.length],2400);
      if(catClicks%3===0)window.setTimeout(()=>minuteSay('Eu ouvi isso.',2500),800);
    });

    window.addEventListener('pagehide',()=>{
      window.clearTimeout(sequenceTimer);
      window.clearTimeout(bubbleTimer);
    },{once:true});
  }
</script>
