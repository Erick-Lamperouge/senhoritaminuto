<section class="fernando-tribute" aria-labelledby="fernando-tribute-title">
  <div class="tribute-copy">
    <span class="eyebrow">POR TRÁS DO NOME</span>
    <h2 id="fernando-tribute-title">Uma homenagem que virou personagem.</h2>
    <p>
      O nome FERNANDO também é uma homenagem ao meu sogro. Nesta página, a homenagem ganha uma versão em pixel art,
      com algumas frases e lembranças que fazem parte do jeito dele.
    </p>
    <p class="tribute-note">A interação é opcional: clique no personagem para ouvir uma das falas.</p>
  </div>

  <div class="tribute-character-wrap">
    <div class="tribute-bubble" id="fernandoBubble" hidden></div>
    <button class="fernando-character" id="fernandoCharacter" type="button" aria-label="Conversar com Fernando">
      <img src="/assets/characters/fernando-pixel.png" alt="Fernando em caricatura pixelada" draggable="false" />
    </button>
    <div class="tribute-prop" id="fernandoProp" aria-hidden="true"></div>
  </div>
</section>

<style>
  .fernando-tribute{margin:72px 0 54px;padding:34px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.022),rgba(255,255,255,.005));display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:36px;align-items:center;overflow:visible}
  .tribute-copy h2{font-family:Georgia,'Times New Roman',serif;font-weight:500;font-size:clamp(1.9rem,3.5vw,3rem);line-height:1.04;margin:10px 0 18px;letter-spacing:-.03em}
  .tribute-copy p{color:var(--muted);max-width:680px}.tribute-note{font-size:.76rem;opacity:.82;margin-top:20px}
  .tribute-character-wrap{position:relative;min-height:290px;display:flex;align-items:flex-end;justify-content:center}
  .fernando-character{width:200px;height:280px;padding:0;border:0;background:transparent;cursor:pointer;position:relative;z-index:3;transform-origin:center bottom;animation:fernando-idle 4.2s ease-in-out infinite}
  .fernando-character:hover{animation-play-state:paused;transform:translateY(-3px)}
  .fernando-character img{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;pointer-events:none;user-select:none;filter:drop-shadow(5px 7px 0 rgba(0,0,0,.22))}
  @keyframes fernando-idle{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-3px) rotate(.45deg)}}
  .fernando-character.greet{animation:fernando-greet .72s ease-in-out 4}
  @keyframes fernando-greet{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-4px) translateX(4px) rotate(1.6deg)}}
  .tribute-bubble{position:absolute;right:178px;top:24px;width:240px;padding:11px 13px;background:#f2e4c4;color:#25231d;border:3px solid #282c2b;box-shadow:4px 4px 0 rgba(0,0,0,.3);font-size:.74rem;line-height:1.42;z-index:8}
  .tribute-bubble::after{content:'';position:absolute;right:-9px;top:48px;width:13px;height:13px;background:#f2e4c4;border-right:3px solid #282c2b;border-top:3px solid #282c2b;transform:rotate(45deg)}
  .tribute-prop{position:absolute;right:-4px;bottom:24px;min-width:62px;min-height:56px;opacity:0;transform:translateY(8px) scale(.8);transition:opacity .22s ease,transform .3s ease;z-index:5;background:rgba(8,12,14,.42);border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(4px);border-radius:14px;padding:6px 8px;display:flex;align-items:center;justify-content:center;gap:6px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
  .tribute-prop.active{opacity:1;transform:translateY(0) scale(1)}
  .tribute-prop img{display:block;image-rendering:pixelated;user-select:none;pointer-events:none}
  .tribute-prop[data-prop='domino'] img{width:30px;height:auto}
  .tribute-prop[data-prop='checkers'] img{width:42px;height:auto}
  .tribute-prop[data-prop='heart'] img{width:38px;height:auto}
  @media(max-width:900px){.fernando-tribute{grid-template-columns:1fr}.tribute-character-wrap{min-height:260px;justify-content:flex-start}.tribute-bubble{left:210px;right:auto;top:28px}.tribute-bubble::after{left:-9px;right:auto;border-right:0;border-top:0;border-left:3px solid #282c2b;border-bottom:3px solid #282c2b}}
  @media(max-width:620px){.fernando-tribute{padding:24px}.fernando-character{width:170px;height:240px}.tribute-character-wrap{min-height:230px}.tribute-bubble{left:122px;top:8px;width:190px;font-size:.69rem}.tribute-prop{right:auto;left:150px;bottom:12px}}
</style>

<script>
  const fernando=document.querySelector('#fernandoCharacter');
  const bubble=document.querySelector('#fernandoBubble');
  const prop=document.querySelector('#fernandoProp');

  if(fernando instanceof HTMLButtonElement&&bubble instanceof HTMLElement&&prop instanceof HTMLElement){
    const lines=[
      {text:'Arigó!',prop:''},
      {text:'Minha família é do sertão. Povo arretado de bom!',prop:''},
      {text:'Bora jogar dominó? Aí a conversa fica séria.',prop:'domino'},
      {text:'Sou muito bom na dama, viu?',prop:'checkers'},
      {text:'A primeira fala de Valentina foi “Vovô”. Essa eu guardo comigo.',prop:'heart'}
    ];
    let bubbleTimer=0;
    let autoTimer=0;
    let last=-1;

    const clearProp=()=>{
      prop.className='tribute-prop';
      prop.removeAttribute('data-prop');
      prop.innerHTML='';
    };

    const renderProp=(kind)=>{
      clearProp();
      if(!kind) return;
      prop.dataset.prop=kind;
      if(kind==='domino'){
        prop.innerHTML=`<img src="/assets/props/domino_piece_1.png" alt="" draggable="false" /><img src="/assets/props/domino_piece_2.png" alt="" draggable="false" style="transform:rotate(12deg) translateY(2px)" />`;
      } else if(kind==='checkers'){
        prop.innerHTML=`<img src="/assets/props/checker_piece.png" alt="" draggable="false" />`;
      } else if(kind==='heart'){
        prop.innerHTML=`<img src="/assets/props/heart_small.png" alt="" draggable="false" />`;
      }
      prop.classList.add('active');
    };

    const showLine=(line,duration=4200)=>{
      bubble.textContent=line.text;
      bubble.hidden=false;
      fernando.classList.remove('greet');
      void fernando.offsetWidth;
      fernando.classList.add('greet');
      renderProp(line.prop);
      window.clearTimeout(bubbleTimer);
      bubbleTimer=window.setTimeout(()=>{
        bubble.hidden=true;
        fernando.classList.remove('greet');
        clearProp();
      },duration);
    };

    const randomLine=()=>{
      let index=Math.floor(Math.random()*lines.length);
      if(lines.length>1&&index===last)index=(index+1)%lines.length;
      last=index;
      showLine(lines[index]);
    };

    const scheduleAuto=()=>{
      window.clearTimeout(autoTimer);
      autoTimer=window.setTimeout(()=>{
        if(document.visibilityState==='visible')randomLine();
        scheduleAuto();
      },24000+Math.random()*18000);
    };

    fernando.addEventListener('click',randomLine);
    scheduleAuto();

    window.addEventListener('pagehide',()=>{
      window.clearTimeout(bubbleTimer);
      window.clearTimeout(autoTimer);
    },{once:true});
  }
</script>
