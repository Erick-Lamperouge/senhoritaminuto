<section class="fernando-tribute" aria-labelledby="fernando-tribute-title">
  <div class="tribute-copy">
    <span class="eyebrow" data-i18n="fernando.tributeEyebrow">POR TRÁS DO NOME</span>
    <h2 id="fernando-tribute-title" data-i18n="fernando.tributeTitle">Uma homenagem que virou personagem.</h2>
    <p data-i18n="fernando.tributeText">
      O nome FERNANDO também é uma homenagem ao meu sogro. Nesta página, a homenagem ganha uma presença interativa,
      com frases e lembranças que fazem parte do jeito dele.
    </p>
    <p class="tribute-note" data-i18n="fernando.tributeNote">A interação é opcional: clique no personagem para ouvir uma das falas.</p>
  </div>

  <div class="tribute-character-wrap">
    <div class="tribute-bubble" id="fernandoBubble" hidden></div>
    <button class="fernando-character" id="fernandoCharacter" type="button" aria-label="Conversar com Fernando" data-pose="base">
      <img id="fernandoCharacterImg" src="/assets/characters/fernando-pixel.png" alt="Fernando em caricatura pixelada" draggable="false" />
    </button>
    <div class="tribute-prop" id="fernandoProp" aria-hidden="true"></div>
  </div>
</section>

<style>
  .fernando-tribute{margin:72px 0 54px;padding:34px;border:1px solid var(--line);background:linear-gradient(145deg,rgba(255,255,255,.022),rgba(255,255,255,.005));display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:36px;align-items:center;overflow:visible}
  .tribute-copy h2{font-family:Georgia,'Times New Roman',serif;font-weight:500;font-size:clamp(1.9rem,3.5vw,3rem);line-height:1.04;margin:10px 0 18px;letter-spacing:-.03em}
  .tribute-copy p{color:var(--muted);max-width:680px}
  .tribute-note{font-size:.76rem;opacity:.82;margin-top:20px}

  .tribute-character-wrap{position:relative;min-height:316px;display:flex;align-items:flex-end;justify-content:center;padding-right:106px}
  .fernando-character{width:220px;height:294px;padding:0;border:0;background:transparent;cursor:pointer;position:relative;z-index:3;transform-origin:center bottom;animation:fernando-idle 4.2s ease-in-out infinite}
  .fernando-character:hover{animation-play-state:paused;transform:translateY(-3px)}
  .fernando-character img{display:block;width:100%;height:100%;object-fit:contain;image-rendering:pixelated;pointer-events:none;user-select:none;filter:drop-shadow(5px 7px 0 rgba(0,0,0,.22));transform-origin:center bottom}
  .fernando-character[data-pose='base'] img{transform:translateY(0) scale(1)}
  .fernando-character[data-pose='thumbs'] img{transform:translateY(0) scale(1)}
  .fernando-character[data-pose='thinking'] img{transform:translateY(0) scale(1)}

  @keyframes fernando-idle{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-3px) rotate(.45deg)}}
  .fernando-character.pose-pop{animation:fernando-pose-pop .72s ease-in-out 2}
  @keyframes fernando-pose-pop{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-4px) scale(1.015)}}

  .tribute-bubble{position:absolute;right:250px;top:18px;max-width:244px;width:fit-content;padding:10px 12px;background:#f2e4c4;color:#25231d;border:3px solid #282c2b;box-shadow:4px 4px 0 rgba(0,0,0,.3);font-size:.74rem;line-height:1.42;z-index:8}
  .tribute-bubble::after{content:'';position:absolute;right:-9px;top:50%;margin-top:-6px;width:13px;height:13px;background:#f2e4c4;border-right:3px solid #282c2b;border-top:3px solid #282c2b;transform:rotate(45deg)}

  .tribute-prop{position:absolute;right:0;bottom:118px;width:100px;height:76px;opacity:0;transform:translateY(8px) scale(.86);transition:opacity .22s ease,transform .3s ease;z-index:2;background:linear-gradient(180deg,rgba(15,20,22,.72),rgba(8,12,14,.52));border:1px solid rgba(255,255,255,.10);backdrop-filter:blur(4px);border-radius:16px;padding:8px 10px;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 24px rgba(0,0,0,.18);pointer-events:none}
  .tribute-prop.active{opacity:1;transform:translateY(0) scale(1)}
  .tribute-prop img{display:block;image-rendering:pixelated;user-select:none;pointer-events:none;max-width:100%;height:auto}
  .tribute-prop[data-prop='domino'] img{width:28px}
  .tribute-prop[data-prop='checkers'] img{width:62px}
  .tribute-prop[data-prop='heart'] img{width:40px}

  @media(max-width:980px){
    .fernando-tribute{grid-template-columns:1fr}
    .tribute-character-wrap{min-height:282px;justify-content:flex-start;padding-right:0;padding-left:10px}
    .tribute-bubble{left:214px;right:auto;top:18px}
    .tribute-bubble::after{left:-9px;right:auto;border-right:0;border-top:0;border-left:3px solid #282c2b;border-bottom:3px solid #282c2b}
    .tribute-prop{right:auto;left:176px;bottom:18px}
  }

  @media(max-width:620px){
    .fernando-tribute{padding:24px}
    .fernando-character{width:176px;height:238px}
    .tribute-character-wrap{min-height:240px;padding-left:0}
    .tribute-bubble{left:118px;top:8px;max-width:194px;width:fit-content;font-size:.69rem}
    .tribute-prop{left:138px;bottom:8px;width:92px;height:70px}
    .tribute-prop[data-prop='checkers'] img{width:54px}
  }
</style>

<script>
  const fernando = document.querySelector('#fernandoCharacter');
  const bubble = document.querySelector('#fernandoBubble');
  const prop = document.querySelector('#fernandoProp');
  const fernandoImg = document.querySelector('#fernandoCharacterImg');

  if (fernando instanceof HTMLButtonElement && bubble instanceof HTMLElement && prop instanceof HTMLElement && fernandoImg instanceof HTMLImageElement) {
    const POSES = {
      base: '/assets/characters/fernando-pixel.png',
      thumbs: '/assets/characters/fernando-thumbsup.png',
      thinking: '/assets/characters/fernando-thinking.png'
    };

    const tx=(key,fallback)=>window.SM_I18N?.t?.(key,fallback) ?? fallback;
    const getLines=()=>[
      { text: tx('fernando.line1','Arigó!'), pose: 'thumbs', prop: null, duration: 2600 },
      { text: tx('fernando.line2','Minha família é do sertão. Povo arretado de bom!'), pose: 'thinking', prop: null, duration: 4200 },
      { text: tx('fernando.line3','Bora jogar dominó? Aí a conversa fica séria.'), pose: 'base', prop: 'domino', duration: 4400 },
      { text: tx('fernando.line4','Sou muito bom na dama, viu?'), pose: 'thumbs', prop: 'checkers', duration: 4200 },
      { text: tx('fernando.line5','A primeira fala de Valentina foi “Vovô”. Essa eu guardo comigo.'), pose: 'thinking', prop: 'heart', duration: 5200 }
    ];

    let bubbleTimer = 0;
    let autoTimer = 0;
    let lastIndex = -1;

    const resetPose = () => {
      fernando.dataset.pose = 'base';
      fernandoImg.src = POSES.base;
    };

    const clearProp = () => {
      prop.className = 'tribute-prop';
      prop.removeAttribute('data-prop');
      prop.innerHTML = '';
    };

    const renderProp = (kind) => {
      clearProp();
      if (!kind) return;
      prop.dataset.prop = kind;

      if (kind === 'domino') {
        prop.innerHTML = `
          <img src="/assets/props/domino_piece_1.png" alt="" draggable="false" />
          <img src="/assets/props/domino_piece_2.png" alt="" draggable="false" />
        `;
      } else if (kind === 'checkers') {
        prop.innerHTML = `<img src="/assets/props/checker_piece.png" alt="" draggable="false" />`;
      } else if (kind === 'heart') {
        prop.innerHTML = `<img src="/assets/props/heart_small.png" alt="" draggable="false" />`;
      }

      prop.classList.add('active');
    };

    const showLine = (entry) => {
      bubble.textContent = entry.text;
      bubble.hidden = false;
      fernando.dataset.pose = entry.pose;
      fernandoImg.src = POSES[entry.pose] || POSES.base;

      fernando.classList.remove('pose-pop');
      void fernando.offsetWidth;
      fernando.classList.add('pose-pop');

      renderProp(entry.prop);

      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => {
        bubble.hidden = true;
        fernando.classList.remove('pose-pop');
        clearProp();
        resetPose();
      }, entry.duration);
    };

    const randomLine = () => {
      const lines=getLines();
      let next = Math.floor(Math.random() * lines.length);
      if (lines.length > 1 && next === lastIndex) next = (next + 1) % lines.length;
      lastIndex = next;
      showLine(lines[next]);
    };

    const scheduleAuto = () => {
      window.clearTimeout(autoTimer);
      autoTimer = window.setTimeout(() => {
        if (document.visibilityState === 'visible') randomLine();
        scheduleAuto();
      }, 24000 + Math.random() * 18000);
    };

    fernando.addEventListener('click', randomLine);
    scheduleAuto();

    window.addEventListener('pagehide', () => {
      window.clearTimeout(bubbleTimer);
      window.clearTimeout(autoTimer);
    }, { once: true });
  }
</script>
